<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ih="clr-namespace:nearby"
             x:Class="nearby.ContentViews.Elements.ContactView"
             x:Name="thisControl">
    <Border Style="{StaticResource EditSection}" 
            Padding="12,8" 
            Margin="0"
            HorizontalOptions="Start"
            StrokeShape="RoundRectangle 6">
        <Grid ColumnDefinitions="Auto, *">
            <Image Grid.Column="0" ih:IconHelper.Icon="{Binding Image, Source={x:Reference thisControl}}" Scale="1.2" Style="{StaticResource AutoTint}"/>
            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Start" Margin="10,0,0,0">
                <Label Style="{StaticResource EditLabel}" Text="{Binding Title, Source={x:Reference thisControl}}" />
                <Label Style="{StaticResource CommonLabel}" FontAttributes="Bold" Text="{Binding Text, Source={x:Reference thisControl}}"/>
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
