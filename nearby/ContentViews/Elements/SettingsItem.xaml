<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:nearby"
             x:Class="nearby.ContentViews.Elements.SettingsItem"
             x:Name="thisControl"
             Padding="0"
             Margin="0">
    <VerticalStackLayout>
        <HorizontalStackLayout Spacing="8">
            <Image local:IconHelper.Icon="{Binding Icon, Source={x:Reference thisControl}}" local:IconHelper.Color="CPrimary" Margin="12" Scale="1.5" VerticalOptions="Center"/>
            <Label Style="{StaticResource CommonLabel}" Text="{Binding Text, Source={x:Reference thisControl}}" HorizontalOptions="Start" VerticalOptions="Center"/>
        </HorizontalStackLayout>
        <!--<BoxView Style="{StaticResource SplitLine}"/>-->
    </VerticalStackLayout>
</ContentView>
