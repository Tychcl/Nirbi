<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:theme="clr-namespace:nearby.Classes"
             x:Class="nearby.ContentViews.Elements.ThemeMiniView"
             x:Name="thisControl">
    <Border Style="{StaticResource EditSection}" Padding="12">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnThemeCardTapped" />
        </Border.GestureRecognizers>
        <HorizontalStackLayout Spacing="12">
            <Border StrokeShape="RoundRectangle 12" 
                Stroke="{DynamicResource CBorder}" 
                StrokeThickness="1"
                WidthRequest="48" HeightRequest="48"
                Padding="0">
                <Grid ColumnDefinitions="*,*" RowDefinitions="*,*">
                    <BoxView Color="{DynamicResource CPrimary}" 
                         Grid.Row="0" Grid.Column="0" />
                    <BoxView Color="{DynamicResource CBackground}" 
                         Grid.Row="0" Grid.Column="1" />
                    <BoxView Color="{DynamicResource CSurface}" 
                         Grid.Row="1" Grid.Column="0" />
                    <BoxView Color="{DynamicResource CTextPrimary}" 
                         Grid.Row="1" Grid.Column="1" />
                </Grid>
            </Border>
            <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                <Label x:Name="Name" Style="{StaticResource BoldCommonLabel}"/>
                <Label Style="{StaticResource SecondaryCommonLabel}" x:Name="Desc"/>
            </VerticalStackLayout>
        </HorizontalStackLayout>
    </Border>
</ContentView>
