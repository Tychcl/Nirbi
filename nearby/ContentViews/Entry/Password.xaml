<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:nearby"
             x:Class="nearby.ContentViews.Entry.Password"
             x:Name="thisControl">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Entry x:Name="PEntry" Style="{StaticResource EditEntry}"
               Grid.Column="0"
               Margin="0"
               Text="{Binding Text, Source={x:Reference thisControl}}" 
               Placeholder="{Binding Placeholder, Source={x:Reference thisControl}}"
               IsPassword="True" />

        <ImageButton x:Name="ToggleButton"
                     Grid.Column="1" 
                     Clicked="OnTogglePasswordClicked"
                     Aspect="AspectFit"
                     ScaleX="0.9"
                     ScaleY="0.9"
                     local:IconHelper.Color="CPrimary" local:IconHelper.Icon="{StaticResource VisibleOff}"/>
    </Grid>
</ContentView>