<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewModels="clr-namespace:nearby.ViewModels"
             xmlns:classes="clr-namespace:nearby.Classes"
             xmlns:CVE="clr-namespace:nearby.ContentViews.Entry"
             x:Class="nearby.Views.Auth.LoginPage"
             x:DataType="viewModels:LoginViewModel">
    <Border Margin="10,0" Style="{StaticResource EditSection}" VerticalOptions="Center">
    <VerticalStackLayout Spacing="15">
            <Label Text="Вход" FontSize="24" HorizontalOptions="Center" Style="{StaticResource SectionTitle}" Margin="0"/>

        <Entry Placeholder="Телефон или Email" 
               Style="{StaticResource EditEntry}"
               Text="{Binding Login}" 
               Keyboard="Email" Margin="0"/>
        <CVE:Password Text="{Binding Password}" Placeholder="Введите пароль" />
        <Label IsVisible="{Binding HasErrors}" 
                Text="{Binding ErrorMessage}" 
                Style="{StaticResource ErrorLabel}" Margin="0"/>

        <Button Text="Войти" 
                Command="{Binding LoginCommand}" />
    </VerticalStackLayout>
    </Border>
</ContentPage>