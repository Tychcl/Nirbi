<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:header="clr-namespace:nearby.ContentViews.Headers"
             xmlns:el="clr-namespace:nearby.ContentViews.Elements"
             xmlns:ih="clr-namespace:nearby"
             x:Class="nearby.Views.Main.CreateChatPage"
             xmlns:viewModels="clr-namespace:nearby.ViewModels"
             xmlns:models="clr-namespace:nearby.Models"
             x:DataType="viewModels:CreateChatViewModel">
    <Shell.TitleView>
        <header:BaseHeaderView Icon="{StaticResource Confirm}" Text="{Binding PageTitle}" BackIsVisible="True">
            <header:BaseHeaderView.ExtraContent>
                <Label Style="{StaticResource SectionTitle}" 
                    Text="{Binding PageTitle}" 
                    HorizontalOptions="Center"
                    Margin="0" 
                    VerticalTextAlignment="Center"
                    VerticalOptions="Center"/>
            </header:BaseHeaderView.ExtraContent>
        </header:BaseHeaderView>
    </Shell.TitleView>
    <VerticalStackLayout>
        <Border Style="{StaticResource EditSection}">
            <VerticalStackLayout>
                <Label Style="{StaticResource SectionTitle}" Text="Первое сообщение"/>
                <Label Style="{StaticResource EditLabel}" Text="Сообщение"/>
                <Editor Style="{StaticResource EditEditor}" Text="{Binding FirstMessage}" Placeholder="Привет!!!"/>
            </VerticalStackLayout>
        </Border>
        <Border Style="{StaticResource Card}" Padding="0" Margin="20,0,20,0">
            <VerticalStackLayout>
                <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,6">
                    <Image Grid.Column="0" ih:IconHelper.Icon="{StaticResource Search}" HorizontalOptions="Start" VerticalOptions="Center" WidthRequest="28" HeightRequest="28" Margin="6"/>
                    <Entry Grid.Column="1" Margin="0" Text="{Binding SearchQuery}" Placeholder="Поиск по имени или почте..." VerticalOptions="Center"/>
                    <ImageButton Grid.Column="2" ih:IconHelper.Icon="{StaticResource Cancel}" VerticalOptions="Center" ih:IconHelper.Color="CError" Command="{Binding ClearSearchCommand}"/>
                </Grid>
                <BoxView IsVisible="{Binding SearchResultsVisibilitty}" Style="{StaticResource SplitLine}" Margin="0,0,0,10"/>
                <CollectionView ItemsSource="{Binding SearchResults}"
                    SelectionMode="None" MaximumHeightRequest="300"
                    Margin="10,0" IsVisible="{Binding SearchResultsVisibilitty}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:User">
                            <Border Style="{StaticResource Card}" HorizontalOptions="FillAndExpand" Margin="0,0,0,12">
                                <el:MiniUserProfile IsFullNameMode="True" User="{Binding .}" Margin="0">
                                    <el:MiniUserProfile.ExtraContent>
                                        <Button ih:IconHelper.Icon="{StaticResource Confirm}" 
                                                ih:IconHelper.Color="CSuccess" 
                                                Style="{StaticResource ImageButtonBorder}" 
                                                ih:IconHelper.Size="36" 
                                                BorderColor="{DynamicResource CSuccess}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:CreateChatViewModel}}, Path=AddUserCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </el:MiniUserProfile.ExtraContent>
                                </el:MiniUserProfile>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentPage>