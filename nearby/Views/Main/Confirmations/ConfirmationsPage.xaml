<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:nearby.ViewModels"
             xmlns:models="clr-namespace:nearby.Models"
             xmlns:element="clr-namespace:nearby.ContentViews.Elements"
             xmlns:ih="clr-namespace:nearby"
             xmlns:header="clr-namespace:nearby.ContentViews.Headers"
             x:Class="nearby.Views.Main.ConfirmationsPage"
             x:DataType="viewModels:ConfirmationsViewModel">
    <Shell.TitleView>
        <header:BaseHeaderView Text="{Binding PageTitle}" BackIsVisible="False" />
    </Shell.TitleView>
    <Grid RowDefinitions="Auto, Auto, *" Padding="0" RowSpacing="0" Margin="0,16,0,0">
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="20,0,20,0">
            <Grid ColumnDefinitions="*,*" HeightRequest="50" ColumnSpacing="10">
                <Border Style="{StaticResource EditSection}" Margin="0" Padding="0" StrokeThickness="0" StrokeShape="RoundRectangle 4">
                    <Button Text="Полученные"
                            BackgroundColor="{Binding IsReceivedSelected, Converter={StaticResource TabBackgroundConverter}, ConverterParameter=true}"
                            TextColor="{Binding IsReceivedSelected, Converter={StaticResource TabTextColorConverter}, ConverterParameter=true}"
                            Command="{Binding SwitchTabCommand}" CommandParameter="received" />
                </Border>
                <Border Grid.Column="1" Style="{StaticResource EditSection}" Margin="0" Padding="0" StrokeThickness="0" StrokeShape="RoundRectangle 4">
                    <Button Text="Отправленные"
                            BackgroundColor="{Binding IsReceivedSelected, Converter={StaticResource TabBackgroundConverter}, ConverterParameter=false}"
                            TextColor="{Binding IsReceivedSelected, Converter={StaticResource TabTextColorConverter}, ConverterParameter=false}"
                            Command="{Binding SwitchTabCommand}" CommandParameter="sent" />
                </Border>
            </Grid>
        </Border>
        <Label Grid.Row="1" Margin="23,0" HeightRequest="30" Style="{StaticResource CommonLabel}" Text="{Binding CountText}" VerticalTextAlignment="Center"/>
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding SelectedList}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Confirmation">
                    <Border Style="{StaticResource EditSection}" Margin="20,5">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding TaskName}" Style="{StaticResource SectionTitle}" Margin="0">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:ConfirmationsViewModel}}, Path=GoToTaskCommand}"
                                                          CommandParameter="{Binding EntityId}"/>
                                </Label.GestureRecognizers>
                            </Label>
                            <Grid ColumnDefinitions="*, Auto" RowSpacing="4">
                                <element:MiniUserProfile Grid.Column="0" User="{Binding RelatedUser}" ImageSize="50" IsFullNameMode="True">
                                    <element:MiniUserProfile.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:ConfirmationsViewModel}}, Path=GoToProfileCommand}"
                                                              CommandParameter="{Binding RelatedUser.Id}"/>
                                    </element:MiniUserProfile.GestureRecognizers>
                                </element:MiniUserProfile>
                                <HorizontalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                    <Grid IsVisible="{Binding Source={RelativeSource AncestorType={x:Type viewModels:ConfirmationsViewModel}}, Path=IsReceivedSelected}">
                                        <HorizontalStackLayout IsVisible="{Binding IsPending}" Spacing="5" VerticalOptions="Center">
                                            <Button ih:IconHelper.Icon="{StaticResource Confirm}" 
            ih:IconHelper.Color="CSuccess" 
            Style="{StaticResource ImageButtonBorder}" 
            ih:IconHelper.Size="36" 
            BorderColor="{DynamicResource CSuccess}"
            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:ConfirmationsViewModel}}, Path=AcceptCommand}"
            CommandParameter="{Binding Id}"/>
                                            <Button ih:IconHelper.Icon="{StaticResource Cancel}" 
            ih:IconHelper.Color="CError" 
            Style="{StaticResource ImageButtonBorder}" 
            ih:IconHelper.Size="36" 
            BorderColor="{DynamicResource CError}"
            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:ConfirmationsViewModel}}, Path=RejectCommand}"
            CommandParameter="{Binding Id}"/>
                                        </HorizontalStackLayout>
                                    </Grid>
                                    <Label Text="Принят" TextColor="{DynamicResource CSuccess}" IsVisible="{Binding IsAccepted}" VerticalOptions="Center"/>
                                    <Label Text="Отклонён" TextColor="{DynamicResource CError}" IsVisible="{Binding IsRejected}" VerticalOptions="Center"/>
                                    <Label Text="Отозван" TextColor="{DynamicResource CTextSecondary}" IsVisible="{Binding IsRevoked}" VerticalOptions="Center"/>
                                    <Grid IsVisible="{Binding Source={RelativeSource AncestorType={x:Type viewModels:ConfirmationsViewModel}}, Path=IsReceivedSelected, Converter={StaticResource InverseBoolConverter}}">
                                        <Button Text="Отозвать" IsVisible="{Binding IsPending}" 
        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:ConfirmationsViewModel}}, Path=RevokeCommand}"
        CommandParameter="{Binding Id}" />
                                    </Grid>
                                </HorizontalStackLayout>
                            </Grid>
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Style="{StaticResource EditLabel}" FontSize="12"
Text="{Binding CreatedAt, StringFormat='Создан: {0:dd.MM.yyyy HH:mm}'}" />
                                    <Label Style="{StaticResource EditLabel}" FontSize="12"
Text="{Binding ExpiresAt, StringFormat='Истекает: {0:dd.MM.yyyy HH:mm}'}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" VerticalOptions="Center" Style="{StaticResource CommonLabel}" Text="{Binding Type}"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>