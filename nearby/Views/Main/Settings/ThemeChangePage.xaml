<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:el="clr-namespace:nearby.ContentViews.Elements"
             xmlns:header="clr-namespace:nearby.ContentViews.Headers"
             xmlns:vm="clr-namespace:nearby.ViewModels"
             x:Class="nearby.Views.Main.ThemeChangePage"
             Title="Внешний вид"
             x:DataType="vm:ThemeChangeViewModel">
    <Shell.TitleView>
        <header:BaseHeaderView Text="Настройки темы" BackIsVisible="True"/>
    </Shell.TitleView>
    <ScrollView Margin="0,16,0,0">
        <VerticalStackLayout>
            <Border Style="{StaticResource Card}" Padding="0,10">
                <VerticalStackLayout>
                    <Label Style="{StaticResource SectionTitle}" Text="Тема приложения" Margin="10,0,0,10"/>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Resources}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <el:ThemeMiniView Theme="{Binding .}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout>
                    <Label Style="{StaticResource SectionTitle}" Text="Размер Текста" Margin="10,0,0,10"/>
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,0,20,0">
                            <Label Style="{StaticResource CommonLabel}" Text="Основной" Grid.Column="0" Margin="10,0,0,0" VerticalTextAlignment="Center"/>
                            <Slider Minimum="10"  Maximum="20" Value="{Binding PrimaryFontSize}" Grid.Column="1" Margin="0"/>
                            <Label Style="{StaticResource CommonLabel}" Text="{Binding PrimaryFontSize}" Grid.Column="2" VerticalTextAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,0,20,0">
                            <Label Style="{StaticResource SecondaryCommonLabel}" Text="Вторичный" Grid.Column="0" Margin="10,0,0,0" VerticalTextAlignment="Center"/>
                            <Slider Minimum="10"  Maximum="20" Value="{Binding SecondaryFontSize}" Grid.Column="1" Margin="0"/>
                            <Label Style="{StaticResource CommonLabel}" Text="{Binding SecondaryFontSize}" Grid.Column="2" VerticalTextAlignment="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>